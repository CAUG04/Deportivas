# ---------------------------------------------------------------------------
# Copia este fichero a .env y rellena los valores. .env NUNCA se sube a git.
# En GitHub Actions estos valores viven en Settings > Secrets and variables.
# ---------------------------------------------------------------------------

# --- Almacenamiento -------------------------------------------------------
# Backend de persistencia activo: "duckdb" (produccion, coste $0) o "postgres".
DEPORTIVAS_STORAGE_BACKEND=duckdb

# Raiz de todos los datos locales (capa cruda, Parquet, caches).
DEPORTIVAS_DATA_DIR=./data

# Fichero DuckDB. Solo es un motor de consulta sobre los Parquet.
DEPORTIVAS_DUCKDB_PATH=./data/deportivas.duckdb

# Cadena de conexion Postgres. Solo se usa si STORAGE_BACKEND=postgres.
# Coincide con docker-compose.yml para desarrollo local.
DEPORTIVAS_DATABASE_URL=postgresql+psycopg://deportivas:deportivas@localhost:5432/deportivas

# --- Fuentes de datos -----------------------------------------------------
# The Odds API (https://the-odds-api.com) - plan gratuito 500 creditos/mes.
# Sin esta clave no hay captura de cuotas en vivo ni calculo de CLV.
DEPORTIVAS_THE_ODDS_API_KEY=

# User-Agent para los scrapers. Identificate, no suplantes a un navegador.
DEPORTIVAS_HTTP_USER_AGENT=deportivas/0.1 (uso personal)

# Segundos minimos entre peticiones a FBref. Por debajo de 3 te bloquean.
DEPORTIVAS_FBREF_MIN_DELAY_SECONDS=4.0

# FBref bloquea con CAPTCHA a los runners de GitHub Actions; su solver
# (PyAutoGUI) es un no-op en modo headless. Dejar en true en local (nunca
# abre una ventana de Chrome sin pedirlo). Probado en produccion incluso con
# false + Xvfb + "xvfb-run": el solver intenta de verdad y pierde igual
# (ver README, "FBref bloquea con CAPTCHA...") -- por eso los workflows ya
# no tocan esta variable, usan DEPORTIVAS_FBREF_ENABLED en su lugar.
DEPORTIVAS_FBREF_HEADLESS=true

# Si FBref se intenta en absoluto. true por defecto para que "deportivas
# fbref-schedule"/"fbref-stats" invocados a mano funcionen (FBref suele
# dejar pasar una IP normal, solo bloquea IPs de datacenter como las de
# GitHub Actions). daily.yml y sources-health.yml lo ponen en false: con el
# bloqueo ya confirmado y repetible, intentarlo en cada corrida automatizada
# es tiempo de CI perdido en un resultado ya conocido.
DEPORTIVAS_FBREF_ENABLED=true

# --- Operacion ------------------------------------------------------------
DEPORTIVAS_LOG_LEVEL=INFO

# Horas tras las cuales el dato se considera rancio y la UI muestra aviso.
DEPORTIVAS_FRESHNESS_WARNING_HOURS=36

# --- API (Fase 6, opcional) -------------------------------------------------
# Origenes permitidos por CORS para deportivas.api.app, como lista JSON.
# El frontend estatico (Fase 7) no llama a esta API -- lee JSON pre-calculado
# de export/json_export.py -- asi que esto solo importa si corres la API en
# vivo para desarrollo local. Vacio (por defecto) desactiva CORS.
DEPORTIVAS_CORS_ALLOW_ORIGINS=["http://localhost:5173"]
